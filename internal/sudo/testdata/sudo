#!/bin/sh
# A stand-in for sudo. FAKE_SUDO_PASSWORD is the password; the credentials
# are cached while the file FAKE_SUDO_CACHE exists, unless FAKE_SUDO_NOCACHE
# is set (sudo set to always ask). FAKE_SUDO_LOG gets a line per call. With
# FAKE_SUDO_GERMAN set it speaks German, as a translated sudo does, unless
# LC_ALL is C.
# With FAKE_SUDO_WROTE set to a fifo, a validation that cached the
# credentials then writes to the fifo and waits, to be interrupted.
# FAKE_SUDO_SLOW makes one validation slow to leave; see below.
# It understands -k (forget the credentials), -n, -S, -v, -p PROMPT and a command to run.
nonint=0 stdin=0 validate=0 prompt="${SUDO_PROMPT:-Password:}"
[ -n "$FAKE_SUDO_LOG" ] && echo "$*" >> "$FAKE_SUDO_LOG"
while [ $# -gt 0 ]; do
	case "$1" in
	-k) rm -f "$FAKE_SUDO_CACHE"; exit 0 ;;
	-n) nonint=1 ;;
	-S) stdin=1 ;;
	-v) validate=1 ;;
	-p) shift; prompt="$1" ;;
	--) shift; break ;;
	-*) ;;
	*) break ;;
	esac
	shift
done
# With FAKE_SUDO_SLOW set to a file that exists, the next validation that is
# given a password removes the file, writes FAKE_SUDO_SLOW.waiting and waits;
# asked to terminate, it takes a second to leave, as a slow sudo can.
if [ "$validate" = 1 ] && [ "$stdin" = 1 ] && [ "$nonint" = 0 ] && [ -n "$FAKE_SUDO_SLOW" ] && [ -f "$FAKE_SUDO_SLOW" ]; then
	rm -f "$FAKE_SUDO_SLOW"
	sleep 30 &
	pid=$!
	trap 'kill $pid 2>/dev/null; sleep 1; exit 1' TERM
	: > "$FAKE_SUDO_SLOW.waiting"
	wait $pid
	exit 1
fi
cached() { [ -z "$FAKE_SUDO_NOCACHE" ] && [ -f "$FAKE_SUDO_CACHE" ]; }
if ! cached; then
	if [ "$nonint" = 1 ]; then
		echo "sudo: a password is required" >&2
		exit 1
	fi
	user=$(id -un)
	if [ "$stdin" = 1 ] || ! [ -r /dev/tty ]; then
		printf '%s' "$(echo "$prompt" | sed "s/%p/$user/")" >&2
		IFS= read -r given || given=""
	else
		# As sudo does: prompt and read on the terminal, not echoing.
		printf '%s' "$(echo "$prompt" | sed "s/%p/$user/")" > /dev/tty
		saved=$(stty -g < /dev/tty)
		stty -echo < /dev/tty
		IFS= read -r given < /dev/tty || given=""
		stty "$saved" < /dev/tty
		echo > /dev/tty
	fi
	if [ "$given" != "$FAKE_SUDO_PASSWORD" ]; then
		if [ -n "$FAKE_SUDO_GERMAN" ] && [ "$LC_ALL" != C ]; then
			echo "Entschuldigung, versuchen Sie es noch einmal." >&2
			echo "sudo: 1 Fehlversuch bei der Passworteingabe" >&2
		else
			echo "Sorry, try again." >&2
			echo "sudo: no password was provided" >&2
			echo "sudo: 1 incorrect password attempt" >&2
		fi
		exit 1
	fi
	[ -z "$FAKE_SUDO_NOCACHE" ] && : > "$FAKE_SUDO_CACHE"
fi
if [ "$validate" = 1 ]; then
	[ -n "$FAKE_SUDO_WROTE" ] && echo > "$FAKE_SUDO_WROTE" && exec sleep 30
	exit 0
fi
exec "$@"
